       width = 4, height = 6, dpi = 300)
ggsave("metacoder_circular_legend.png", p_legend,
       width = 4, height = 6, dpi = 300)
cat("\nSaved: metacoder_circular_legend.pdf and .png\n")
cat("Tip: composite this legend with the heat_tree_matrix PDF in Illustrator/Inkscape\n")

##################################################################################
# Weighted and unweighted UniFrac
##################################################################################
# ============================================================================
# 1. BUILD PHYLOSEQ OBJECT & RAREFY
# ============================================================================
otu_ps     <- otu_table(as.matrix(otu_raw), taxa_are_rows = TRUE)
tax_ps     <- tax_table(as.matrix(tax_raw))
tree_ps    <- read_tree(TREE_PATH)
tree_ps    <- ape::root(tree_ps, outgroup = tree_ps$tip.label[1], resolve.root = TRUE)
meta_ps    <- meta_raw %>% column_to_rownames("SampleID")
sample_ps  <- sample_data(meta_ps)

ps <- phyloseq(otu_ps, tax_ps, sample_ps, tree_ps)

set.seed(42)
min_depth <- min(sample_sums(ps))
cat("Rarefying to", format(min_depth, big.mark = ","), "reads per sample\n")
ps_rare <- rarefy_even_depth(ps, sample.size = min_depth,
                              rngseed = 42, replace = FALSE, verbose = FALSE)

# ============================================================================
# 2. TREATMENT LABELS, COLOURS & SHAPES
# ============================================================================
trt_level_order <- c("Control+Water", "Control+SMT", "Strep+Water", "Strep+SMT")

BLUE <- "#1C66C0"
RED  <- "#C0392B"

trt_colors <- c(
  "Control+Water" = BLUE,
  "Control+SMT"   = BLUE,
  "Strep+Water"   = RED,
  "Strep+SMT"     = RED
)

# Circle = Control, Triangle = Strep
trt_shapes <- c(
  "Control+Water" = 21,
  "Control+SMT"   = 21,
  "Strep+Water"   = 24,
  "Strep+SMT"     = 24
)

# Grey border = SMT, black border = no SMT
trt_stroke <- c(
  "Control+Water" = "black",
  "Control+SMT"   = "#AAAAAA",
  "Strep+Water"   = "black",
  "Strep+SMT"     = "#AAAAAA"
)

sample_data(ps_rare)$Treatment_label <- factor(
  case_when(
    sample_data(ps_rare)$Treatment == "T1" ~ "Control+Water",
    sample_data(ps_rare)$Treatment == "T2" ~ "Control+SMT",
    sample_data(ps_rare)$Treatment == "T3" ~ "Strep+Water",
    sample_data(ps_rare)$Treatment == "T4" ~ "Strep+SMT"
  ),
  levels = trt_level_order
)

sample_data(ps_rare)$Treatment2 <- trimws(
  as.character(sample_data(ps_rare)$Treatment2)
)

# ============================================================================
# 3. PERMANOVA
# ============================================================================
cat("\nRunning PERMANOVA (Bray-Curtis, Unweighted UniFrac, Weighted UniFrac)...\n")

uf_dist  <- UniFrac(ps_rare, weighted = FALSE, normalized = TRUE)
wuf_dist <- UniFrac(ps_rare, weighted = TRUE,  normalized = TRUE)

trt_vec  <- as.character(sample_data(ps_rare)$Treatment_label)

perm_uf  <- adonis2(uf_dist  ~ trt_vec, permutations = 999)
perm_wuf <- adonis2(wuf_dist ~ trt_vec, permutations = 999)

cat("\nUnweighted UniFrac PERMANOVA:\n"); print(perm_uf)
cat("\nWeighted UniFrac PERMANOVA:\n");   print(perm_wuf)

fmt_p <- function(p) {
  case_when(p < 0.001 ~ "< 0.001", p < 0.01 ~ "< 0.01",
            p < 0.05  ~ "< 0.05",  TRUE ~ paste0("= ", round(p, 3)))
}
perm_uf_label  <- paste0("PERMANOVA  p ", fmt_p(perm_uf$`Pr(>F)`[1]))
perm_wuf_label <- paste0("PERMANOVA  p ", fmt_p(perm_wuf$`Pr(>F)`[1]))

# ============================================================================
# 4. PCoA ORDINATIONS
# ============================================================================
cat("\nComputing PCoA ordinations...\n")
ord_uf  <- ordinate(ps_rare, method = "PCoA", distance = uf_dist)
ord_wuf <- ordinate(ps_rare, method = "PCoA", distance = wuf_dist)

get_pct <- function(ord) {
  eig     <- ord$values$Eigenvalues
  eig_pos <- eig[eig > 0]
  round(eig_pos / sum(eig_pos) * 100, 1)
}
pct_uf  <- get_pct(ord_uf)
pct_wuf <- get_pct(ord_wuf)
cat("Unweighted UniFrac — PC1:", pct_uf[1], "%  PC2:", pct_uf[2], "%\n")
cat("Weighted UniFrac   — PC1:", pct_wuf[1], "%  PC2:", pct_wuf[2], "%\n")

