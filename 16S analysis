# ============================================================================
# 6. ORDINATION PLOT HELPER
# ============================================================================
make_ord_plot <- function(ord, ps_obj, pct, perm_label, title) {

  # Extract coordinates
  coords <- as.data.frame(ord$vectors[, 1:2])
  colnames(coords) <- c("PC1", "PC2")
  coords$SampleID  <- rownames(coords)

  plot_df <- coords %>%
    left_join(
      data.frame(sample_data(ps_obj)) %>% rownames_to_column("SampleID"),
      by = "SampleID"
    )

  # Ellipses (std dev, drawn manually so they match theme)
  # SMT overlay data
  smt_df <- plot_df %>% filter(Treatment2 == "SMT")

  ggplot(plot_df, aes(x = PC1, y = PC2)) +
    # 95% confidence ellipses per treatment
    stat_ellipse(aes(colour = Treatment_label),
                 type = "norm", level = 0.95,
                 linewidth = 1.0, linetype = "dashed") +
    # sample points — fill=treatment, shape=Control/Strep, stroke=SMT/no SMT
    geom_point(aes(fill   = Treatment_label,
                   shape  = Treatment_label,
                   colour = Treatment_label),
               size = 6, alpha = 0.75, stroke = 0.9) +
    # unicode polka dot overlay for SMT samples
    { if (nrow(smt_df) > 0)
        geom_text(data = smt_df,
                  aes(x = PC1, y = PC2, label = "⁛"),
                  colour = "white", size = 3.5, fontface = "bold",
                  hjust = 0.5, vjust = 0.5, inherit.aes = FALSE)
      else list() } +
    scale_fill_manual(values   = trt_colors, name = "Treatment") +
    scale_colour_manual(values = trt_stroke,  guide = "none") +
    scale_shape_manual(values  = trt_shapes,  name = "Treatment") +
    annotate("text",
             x = Inf, y = Inf,
             label = perm_label,
             hjust = 1.1, vjust = 1.3,
             size = 5, colour = "black", fontface = "italic") +
    labs(
      title = title,
      x     = paste0("PC1  (", pct[1], "% variance)"),
      y     = paste0("PC2  (", pct[2], "% variance)")
    ) +
    dc_theme +
    guides(
      fill  = guide_legend(override.aes = list(
                shape  = c(21, 21, 24, 24),
                colour = c("black","#AAAAAA","black","#AAAAAA"),
                size   = 5)),
      shape = "none"
    )
}

