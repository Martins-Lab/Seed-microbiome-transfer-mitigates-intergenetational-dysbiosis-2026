################################################################################
# 16S rRNA Gene Sequencing Data Analysis
#
# Description:
# This repository contains R scripts for the statistical analysis and
# visualization of 16S rRNA gene sequencing data processed using mothur.
#
# Analyses include microbial community composition, diversity analyses,
# statistical comparisons, and data visualization.
################################################################################
# 1. Load Required R Packages
################################################################################

# Data manipulation and organization
library(dplyr)
library(tidyverse)
library(magrittr)

# Data import
library(readxl)
library(file2meco)

# Microbial community analysis
library(phyloseq)
library(microeco)
library(vegan)
library(metacoder)

# Statistical analysis
library(stats)
library(rstatix)
library(multcompView)

################################################################################
# 2. Load Required Datasets
################################################################################
OTU_PATH  <- "OTU.csv"
TAX_PATH  <- "TAX.csv"
META_PATH <- "Metadata.csv"

otu_raw <- read.csv(OTU_PATH, row.names = 1, check.names = FALSE)
tax_raw <- read.csv(TAX_PATH, check.names = FALSE)
meta_raw <- read.csv(META_PATH, check.names = FALSE)

# Clean metadata column names
colnames(meta_raw) <- gsub("[\u00a0\\s]+", "", colnames(meta_raw), perl = TRUE)
meta_raw$SampleID <- trimws(as.character(meta_raw$SampleName))
meta_raw <- meta_raw %>%
  mutate(Treatment  = trimws(as.character(Treatment)),
         Treatment1 = trimws(as.character(Treatment1)),
         Treatment2 = trimws(as.character(Treatment2)))

# Map treatment codes to labels
trt_label_map <- c(T1 = "Control+Water", T2 = "Control+SMT",
                   T3 = "Strep+Water",   T4 = "Strep+SMT")
meta_raw$Treatment_label <- trt_label_map[meta_raw$Treatment]

cat("Samples:", nrow(meta_raw), "\n")
cat("OTUs:", nrow(otu_raw), "\n")

# ============================================================================
# 3. RAREFY
# ============================================================================
samples  <- meta_raw$SampleID
otu_t    <- t(as.matrix(otu_raw[, samples]))   # samples x OTUs

set.seed(42)
min_depth <- min(rowSums(otu_t))
cat("Rarefying to", format(min_depth, big.mark = ","), "reads\n")
otu_rare <- rrarefy(otu_t, sample = min_depth)

# ============================================================================
# 4. BUILD LINEAGE STRING FOR METACODER FIGURE
# ============================================================================
# Metacoder needs a semicolon-separated lineage column
# Format: Kingdom;Phylum;Class;Order;Family;Genus

# Clean unclassified labels — replace "X_unclassified" with NA equivalent
clean_rank <- function(x) {
  ifelse(grepl("unclassified|incertae|Unknown", x, ignore.case = TRUE), NA, x)
}

tax_clean <- tax_raw %>%
  mutate(across(c(Kingdom, Phylum, Class, Order, Family, Genus), clean_rank)) %>%
  mutate(lineage = paste(
    ifelse(is.na(Kingdom), "Bacteria",       Kingdom),
    ifelse(is.na(Phylum),  "Unknown_Phylum", Phylum),
    ifelse(is.na(Class),   "Unknown_Class",  Class),
    ifelse(is.na(Order),   "Unknown_Order",  Order),
    ifelse(is.na(Family),  "Unknown_Family", Family),
    ifelse(is.na(Genus),   "Unknown_Genus",  Genus),
    sep = ";"
  ))

# ============================================================================
# 5. BUILD METACODER OBJECT
# ============================================================================
# Combine OTU table (OTUs as rows, samples as columns) with lineage
otu_df <- as.data.frame(t(otu_rare)) %>%
  rownames_to_column("OTU") %>%
  left_join(dplyr::select(tax_clean, OTU, lineage), by = "OTU")

cat("OTU table dimensions:", nrow(otu_df), "OTUs x", ncol(otu_df)-2, "samples\n")

obj <- parse_tax_data(
  otu_df,
  class_cols  = "lineage",
  class_sep   = ";",
  class_regex = "^(.+)$",
  class_key   = c(tax_name = "taxon_name")
)

cat("Taxmap object created:", "\n")
print(obj)

# ============================================================================
# 6. FILTER LOW-ABUNDANCE OTUs
# ============================================================================
# Set counts < 5 to zero
obj$data$tax_data <- zero_low_counts(obj, data = "tax_data", min_count = 5)

# Remove OTUs with no reads
no_reads <- rowSums(obj$data$tax_data[, samples]) == 0
obj <- filter_obs(obj, data = "tax_data", !no_reads, drop_taxa = TRUE)
cat("After filtering:", nrow(obj$data$tax_data), "OTUs remaining\n")

# ============================================================================
# 7. FILTER TO FAMILY LEVEL AND ABOVE
# ============================================================================
# Use n_supertaxa() to get the number of ancestors per taxon
# Root = 0 ancestors, Phylum = 1, Class = 2, Order = 3, Family = 4, Genus = 5
# Keep Order and above: n_supertaxa <= 3

n_super <- n_supertaxa(obj)
cat("\nSupertaxa count distribution (5 = Genus):\n")
print(table(n_super))

# Keep Order and above (n_supertaxa <= 3)
obj_family <- filter_taxa(obj,
                          n_super <= 3,
                          reassign_obs = TRUE)

cat("\nTaxa remaining at Order level and above:", nrow(obj_family$data$tax_data), "\n")
obj <- obj_family

# ============================================================================
# 8. COMPUTE TAXON COUNTS PER SAMPLE
# ============================================================================
obj$data$tax_abund <- calc_taxon_abund(obj, "tax_data", cols = samples)

# Add sample metadata
obj$data$sample_data <- tibble(
  sample_id       = samples,
  Treatment_label = meta_raw$Treatment_label[match(samples, meta_raw$SampleID)]
)

# ============================================================================
# 9. PAIRWISE COMPARISONS — all 6 pairs
# ============================================================================
TRT_ORDER <- c("Control+Water","Control+SMT","Strep+Water","Strep+SMT")
pairs <- combn(TRT_ORDER, 2, simplify = FALSE)

# Colours matching your paper scheme
BLUE   <- "#1C66C0"
RED    <- "#C0392B"
GRAY   <- "#888888"

trt_colors <- c(
  "Control+Water" = BLUE,
  "Control+SMT"   = BLUE,
  "Strep+Water"   = RED,
  "Strep+SMT"     = RED
)

# ============================================================================
# 10. PLOT EACH PAIRWISE HEAT TREE
# ============================================================================
pdf("figure_metacoder_heattree_order_pairwise_grey_02.pdf",
    width = 18, height = 12)

par(mfrow = c(2, 3))

# Collect enrichment counts and detailed taxon data across all pairs
enrichment_summary <- data.frame()
all_pair_exports   <- data.frame()

for (pair in pairs) {
  trt_a <- pair[1]
  trt_b <- pair[2]

  cat("\nComparing:", trt_a, "vs", trt_b, "\n")

  # Get sample IDs for each group
  samp_a <- meta_raw$SampleID[meta_raw$Treatment_label == trt_a]
  samp_b <- meta_raw$SampleID[meta_raw$Treatment_label == trt_b]

  # Calculate log2 median ratio between groups
  obj$data$diff_table <- compare_groups(
    obj,
    data       = "tax_abund",
    cols       = samples,
    groups     = meta_raw$Treatment_label[match(samples, meta_raw$SampleID)]
  )

  # Print column names on first iteration to diagnose
  if (identical(pair, pairs[[1]])) {
    cat("compare_groups columns:", colnames(obj$data$diff_table), "\n")
  }

  # Filter to this pair
  pair_diff <- obj$data$diff_table %>%
    dplyr::filter(treatment_1 == trt_a, treatment_2 == trt_b)

  # FDR correction — handle both old (wilcox_p) and new (p_value) column names
  # Column is wilcox_p_value in this version of metacoder
  obj$data$diff_table <- obj$data$diff_table %>%
    mutate(wilcox_p_adj = p.adjust(wilcox_p_value, method = "fdr"))

  # Use metacoder default diverging palette
  col_a <- "#D55E00"    # orange = trt_a enriched (default metacoder)
  col_b <- "#0072B2"    # blue   = trt_b enriched (default metacoder)

  # Filter diff_table to this pair only before plotting
  full_diff <- obj$data$diff_table
  obj$data$diff_table <- full_diff %>%
    dplyr::filter(treatment_1 == trt_a, treatment_2 == trt_b)

  print(
    heat_tree(obj,
              node_label            = taxon_names,
              node_size             = n_obs,
              node_color            = log2_median_ratio,
              node_color_interval   = c(-0.2, 0.2),
              node_color_range      = c("#009E73", "#009E73", "gray90", "gray90", "#D55E00", "#D55E00"),
              node_size_axis_label  = "OTU count",
              node_color_axis_label = paste0(
                trt_a, " (orange) \n",
                trt_b, " (blue) \n",
                "log2 ratio"
              ),
              node_label_size_range = c(0.01, 0.04),
              # Edge (branch) colour matches node enrichment direction
              edge_color            = log2_median_ratio,
              edge_color_interval   = c(-0.2, 0.2),
              edge_color_range      = c("#009E73", "#009E73", "gray90", "gray90", "#D55E00", "#D55E00"),
              edge_size             = 0.0025,
              edge_size_range       = c(0.002, 0.006),
              layout                = "davidson-harel",
              initial_layout        = "reingold-tilford",
              title                 = paste0(trt_a, "  vs  ", trt_b),
              title_size            = 0.04,
              output_file           = NULL
    )
  )

  # ── Count enriched taxa per comparison ──────────────────────────────────────
  pair_stats <- obj$data$diff_table %>%
    dplyr::filter(!is.na(log2_median_ratio)) %>%
    dplyr::summarise(
      total_taxa       = dplyr::n(),
      enriched_in_a    = sum(log2_median_ratio > 0, na.rm = TRUE),
      enriched_in_b    = sum(log2_median_ratio < 0, na.rm = TRUE),
      neutral          = sum(log2_median_ratio == 0, na.rm = TRUE),
      sig_enriched_a   = sum(log2_median_ratio > 0 & wilcox_p_adj < 0.05, na.rm = TRUE),
      sig_enriched_b   = sum(log2_median_ratio < 0 & wilcox_p_adj < 0.05, na.rm = TRUE)
    )

  cat(sprintf(
    "  Total taxa compared: %d\n  %s enriched: %d total (%d FDR sig p<0.05)\n  %s enriched: %d total (%d FDR sig p<0.05)\n  Neutral: %d\n",
    pair_stats$total_taxa,
    trt_a, pair_stats$enriched_in_a, pair_stats$sig_enriched_a,
    trt_b, pair_stats$enriched_in_b, pair_stats$sig_enriched_b,
    pair_stats$neutral
  ))

  # Add to summary table
  enrichment_summary <- rbind(enrichment_summary, data.frame(
    Comparison        = paste(trt_a, "vs", trt_b),
    Treatment_A       = trt_a,
    Treatment_B       = trt_b,
    Total_taxa        = pair_stats$total_taxa,
    Enriched_A        = pair_stats$enriched_in_a,
    Enriched_B        = pair_stats$enriched_in_b,
    Neutral           = pair_stats$neutral,
    Sig_enriched_A    = pair_stats$sig_enriched_a,
    Sig_enriched_B    = pair_stats$sig_enriched_b,
    stringsAsFactors  = FALSE
  ))

  # ── Export detailed taxon enrichment for this pair ───────────────────────────
  # Build taxonomy lookup directly from tax_clean (original taxonomy table)
  # tax_clean has Kingdom, Phylum, Class, Order, Family, Genus and lineage columns
  # Join diff_table taxon names to tax_clean via the taxon name

  # Get taxon name for each taxon_id in the diff_table
  tname_vec <- taxon_names(obj)  # named vector: id -> name
  tname_df  <- data.frame(
    taxon_id = names(tname_vec),
    tax_name = unname(tname_vec),
    stringsAsFactors = FALSE
  )

  # Get n_supertaxa for filtering to family level only
  n_super_now <- n_supertaxa(obj)
  order_ids   <- names(n_super_now)[n_super_now == 3]

  pair_export <- full_diff %>%
    dplyr::filter(treatment_1 == trt_a, treatment_2 == trt_b) %>%
    left_join(tname_df, by = "taxon_id") %>%
    # Keep only order-level taxa
    dplyr::filter(taxon_id %in% order_ids) %>%
    # Join to tax_clean on Family name to get full taxonomy
    left_join(
      tax_clean %>%
        dplyr::filter(!is.na(Order) &
                      !grepl("unclassified|Unknown", Order,
                              ignore.case = TRUE)) %>%
        dplyr::select(Kingdom, Phylum, Class, Order) %>%
        dplyr::distinct(Order, .keep_all = TRUE),
      by = c("tax_name" = "Order")
    ) %>%
    dplyr::mutate(
      comparison  = paste(trt_a, "vs", trt_b),
      direction   = dplyr::case_when(
        log2_median_ratio > 0 ~ paste("Enriched in", trt_a),
        log2_median_ratio < 0 ~ paste("Enriched in", trt_b),
        TRUE                  ~ "Neutral"
      ),
      significant = wilcox_p_adj < 0.05
    ) %>%
    dplyr::select(comparison, taxon_id,
                  Order = tax_name,
                  Class, Phylum, Kingdom,
                  log2_median_ratio, mean_diff,
                  wilcox_p_value, wilcox_p_adj,
                  direction, significant) %>%
    dplyr::arrange(desc(abs(log2_median_ratio)))

  # Append to master export
  all_pair_exports <- rbind(all_pair_exports, pair_export)

  # Restore full diff_table for next iteration
  obj$data$diff_table <- full_diff
}

# ── Save master CSV ───────────────────────────────────────────────────────────
write.csv(all_pair_exports,
          "metacoder_taxon_enrichment_order_full.csv",
          row.names = FALSE)
cat("\nSaved: metacoder_taxon_enrichment_order_full.csv\n")

# ── Phylum-level summary ──────────────────────────────────────────────────────
phylum_summary <- all_pair_exports %>%
  dplyr::filter(!is.na(Phylum), direction != "Neutral") %>%
  dplyr::group_by(comparison, Phylum, direction) %>%
  dplyr::summarise(
    n_orders          = dplyr::n(),
    orders            = paste(sort(unique(Order)), collapse = "; "),
    mean_log2_ratio   = round(mean(log2_median_ratio, na.rm = TRUE), 3),
    max_log2_ratio    = round(max(abs(log2_median_ratio), na.rm = TRUE), 3),
    n_significant     = sum(significant, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  dplyr::arrange(comparison, Phylum, direction)

write.csv(phylum_summary,
          "metacoder_order_enrichment_summary.csv",
          row.names = FALSE)
cat("Saved: metacoder_order_enrichment_summary.csv\n")

cat("\nPhylum enrichment preview:\n")
print(as.data.frame(phylum_summary))

# ── SUMMARY TABLE across all comparisons ─────────────────────────────────────
cat("\n", paste(rep("=", 65), collapse=""), "\n")
cat("ENRICHMENT SUMMARY — all pairwise comparisons (Family level)\n")
cat(paste(rep("=", 65), collapse=""), "\n\n")
print(enrichment_summary)
cat("\n")

# Save summary to CSV
write.csv(enrichment_summary,
          "metacoder_enrichment_summary_family.csv",
          row.names = FALSE)
cat("Saved: metacoder_enrichment_summary_family.csv\n")

dev.off()
cat("\nSaved: figure_metacoder_heattree_order_pairwise_grey_02.pdf\n")

# ============================================================================
# 11. COMBINED MATRIX PLOT (heat_tree_matrix)
# ============================================================================
# This makes a grid of all pairwise comparisons in one figure

cat("\nGenerating heat_tree_matrix...\n")

# Compute comparisons for all groups at once
obj$data$diff_table <- compare_groups(
  obj,
  data   = "tax_abund",
  cols   = samples,
  groups = meta_raw$Treatment_label[match(samples, meta_raw$SampleID)]
)

# Handle column naming differences across metacoder versions
obj$data$diff_table <- obj$data$diff_table %>%
  mutate(
    log2_median_ratio = ifelse(is.finite(log2_median_ratio),
                               log2_median_ratio, 0),
    wilcox_p_adj = p.adjust(wilcox_p_value, method = "fdr")
  )

# Force close ALL open graphics devices before writing new file
while (!is.null(dev.list())) dev.off()
graphics.off()

# Use a unique timestamped filename to avoid file lock issues
