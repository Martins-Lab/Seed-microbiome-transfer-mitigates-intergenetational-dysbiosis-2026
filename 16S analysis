# ============================================================================
# 13. CIRCULAR LEGEND — matching the heat tree colour scale
# ============================================================================
# Creates a standalone circular legend PNG matching the published figure style

library(ggplot2)
library(grid)

TEAL  <- "#009E73"
BROWN <- "#D55E00"
GRAY  <- "gray90"

# ── Colour scale circles (log2 ratio) ────────────────────────────────────────
