ABIOTIC_PATH <- "PJ_2_Microbiome_Next_Gen_ALL_DataSetsss.xlsx"

# ============================================================================
# 2. LOAD & RAREFY OTU
# ============================================================================
library(vegan)
otu_raw  <- read.csv(OTU_PATH, row.names = 1, check.names = FALSE)
tax_raw  <- read.csv(TAX_PATH, row.names = 1, check.names = FALSE)
meta_raw <- read.csv(META_PATH, check.names = FALSE)
colnames(meta_raw) <- gsub("[\u00a0\\s]+", "", colnames(meta_raw), perl = TRUE)
meta_raw$SampleID  <- trimws(as.character(meta_raw$SampleName))
meta_raw <- meta_raw %>%
  mutate(Treatment  = trimws(as.character(Treatment)),
         Treatment1 = trimws(as.character(Treatment1)),
         Treatment2 = trimws(as.character(Treatment2)),
         Block      = as.integer(Block),
         Experiment = as.integer(Experiment))

samples <- meta_raw$SampleID
otu_t   <- t(as.matrix(otu_raw[, samples]))   # samples x OTUs

set.seed(42)
min_depth <- min(rowSums(otu_t))
cat("Rarefying to", format(min_depth, big.mark = ","), "reads\n")
otu_rare <- rrarefy(otu_t, sample = min_depth)
otu_rel  <- otu_rare / rowSums(otu_rare)      # relative abundance

# ============================================================================
# 3. COLLAPSE TO GENUS LEVEL
# ============================================================================
clean_label <- function(row) {
  for (rank in c("Genus","Family","Order","Class","Phylum")) {
    val <- as.character(row[[rank]])
    if (!is.na(val) && val != "" &&
        !grepl("unclassified|incertae|Unknown", val, ignore.case = TRUE)) {
      suffix <- substr(rank, 1, 1)
      return(paste0(val, " (", suffix, ")"))
    }
  }
  return(as.character(row[["Phylum"]]))
}

tax_raw$genus_label <- apply(tax_raw, 1, clean_label)

# Aggregate: for each genus_label, sum relative abundance across OTUs
otu_rel_df  <- as.data.frame(otu_rel)
genus_counts <- lapply(unique(tax_raw$genus_label), function(gl) {
  otus <- rownames(tax_raw)[tax_raw$genus_label == gl]
  otus <- intersect(otus, colnames(otu_rel_df))
  if (length(otus) == 1) otu_rel_df[, otus]
  else rowSums(otu_rel_df[, otus])
})
genus_df <- as.data.frame(do.call(cbind, genus_counts))
colnames(genus_df) <- unique(tax_raw$genus_label)
rownames(genus_df) <- samples

# Filter: present in >= 5 samples
keep <- colnames(genus_df)[colSums(genus_df > 0) >= 5]
genus_df <- genus_df[, keep]
cat("Genus-level taxa (>=5 samples):", ncol(genus_df), "\n")

# ============================================================================
# 4. LOAD qPCR + AUDPC
# ============================================================================
qpcr_raw <- read_excel(ABIOTIC_PATH, sheet = "qPCR", col_names = FALSE)
qpcr <- qpcr_raw[2:nrow(qpcr_raw), 1:6]
colnames(qpcr) <- c("Target","Sample","Tech_Rep","Exp","Block","Norm_Expr")
qpcr <- qpcr %>%
  mutate(Target    = as.character(Target),
         Sample    = trimws(as.character(Sample)),
         Norm_Expr = as.numeric(Norm_Expr),
         Exp       = as.integer(Exp),
         Block     = as.integer(Block)) %>%
  filter(!is.na(Target), !is.na(Norm_Expr))

qpcr_avg <- qpcr %>%
  group_by(Target, Sample, Exp) %>%
  summarise(Norm_Expr = mean(Norm_Expr, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(names_from = Target, values_from = Norm_Expr) %>%
  rename(Treatment = Sample, Experiment = Exp)

ds_sheet  <- read_excel(ABIOTIC_PATH, sheet = "Disease_Severity_AUDPC",
                        col_names = FALSE)
audpc_raw <- ds_sheet[3:nrow(ds_sheet), 30:33]
colnames(audpc_raw) <- c("Treatment","Block","Experiment","AUDPC")
audpc_avg <- audpc_raw %>%
  filter(!is.na(Treatment)) %>%
  mutate(Treatment  = trimws(as.character(Treatment)),
         Experiment = as.integer(Experiment),
         AUDPC      = as.numeric(AUDPC)) %>%
  group_by(Treatment, Experiment) %>%
  summarise(AUDPC = mean(AUDPC, na.rm = TRUE), .groups = "drop")

abiotic <- meta_raw %>%
  left_join(qpcr_avg,  by = c("Treatment","Experiment")) %>%
  left_join(audpc_avg, by = c("Treatment","Experiment"))

# ============================================================================
# 5. SPEARMAN CORRELATIONS: genus x (genes + AUDPC)
# ============================================================================
target_vars <- c("CHI14","Flg_Sens","Gluc","AUDPC")

corr_results <- lapply(target_vars, function(gene) {
  gvals <- abiotic[[gene]]
  lapply(colnames(genus_df), function(taxon) {
    abund <- genus_df[, taxon]
    test  <- cor.test(abund, gvals, method = "spearman", exact = FALSE)
    data.frame(Gene = gene, Taxon = taxon,
               r = test$estimate, p = test$p.value,
               stringsAsFactors = FALSE)
  }) %>% bind_rows()
}) %>% bind_rows()

# FDR per gene
corr_results <- corr_results %>%
  group_by(Gene) %>%
  mutate(p_adj = p.adjust(p, method = "BH")) %>%
  ungroup()

# Top 12 per gene by |r|, take union
top_taxa <- corr_results %>%
  group_by(Gene) %>%
  slice_max(abs(r), n = 12) %>%
  pull(Taxon) %>% unique()

cat("Top taxa selected:", length(top_taxa), "\n")

# ── Pre-compute dominant treatment per taxon for ordering ──────────────────
genus_meta_tmp <- genus_df %>%
  rownames_to_column("SampleID") %>%
  left_join(meta_raw %>% select(SampleID, Treatment1), by = "SampleID") %>%
  mutate(Treatment1 = trimws(gsub("^\\d+_", "", Treatment1)))

TRT1_ORDER_TMP <- c("Control+Water","Control+SMT","Strep+Water","Strep+SMT")

dominant_trt <- sapply(top_taxa, function(taxon) {
  means <- sapply(TRT1_ORDER_TMP, function(t)
    mean(genus_meta_tmp[[taxon]][genus_meta_tmp$Treatment1 == t], na.rm = TRUE))
  trimws(names(which.max(means)))
})

# LDA score proxy for within-group ordering
lda_proxy <- sapply(top_taxa, function(taxon) {
  X  <- log10(genus_meta_tmp[[taxon]] * 1e6 + 1)
  y  <- factor(genus_meta_tmp$Treatment1, levels = TRT1_ORDER_TMP)
  gm <- tapply(X, y, mean)
  om <- mean(X)
  log10(sum(sapply(TRT1_ORDER_TMP, function(t)
    sum(y == t, na.rm = TRUE) * (gm[t] - om)^2),
    na.rm = TRUE) / length(X) + 1)
})

# Build ordering data frame: group by treatment then LDA score
ordering_df <- data.frame(
  Taxon        = top_taxa,
  dominant_trt = dominant_trt,
  lda_proxy    = lda_proxy
) %>%
  mutate(trt_order = match(dominant_trt, TRT1_ORDER_TMP)) %>%
  arrange(trt_order, desc(lda_proxy))

taxa_order <- ordering_df$Taxon

# ── Clean taxon display labels ────────────────────────────────────────────────
# Remove: numbers in parentheses e.g. (83), (75), (95)
# Remove: trailing _1, _2, _III, _IV etc
# Keep:   rank suffix (G), (F), (O), (C), (P)
clean_taxon_label <- function(x) {
  x %>%
    # Remove numbers in parens e.g. Rhodospirillaceae(83) -> Rhodospirillaceae
    gsub("\\(\\d+\\)", "", .) %>%
    # Remove _1, _2, _12 etc (underscore + digits only)
    gsub("_\\d+", "", .) %>%
    # Remove roman numeral suffixes: _III, _XlVa, _XlVb, _XVIII etc
    # Catches mixed case like Xl, lV etc — but NOT Gp10, SR1, BRC1, TM7
    gsub("_[IVXLCivxlc]+[a-z]?\\b", "", .) %>%
    # Clean up any extra whitespace
    gsub("\\s+", " ", .) %>%
    trimws()
}

# Apply to taxa_order and create a lookup for display
taxa_labels <- setNames(clean_taxon_label(taxa_order), taxa_order)
cat("\nTaxon label cleaning:\n")
changed <- taxa_labels[taxa_labels != taxa_order]
if (length(changed) > 0) {
  for (i in seq_along(changed)) {
    cat("  ", names(changed)[i], "->", changed[i], "\n")
  }
} else {
  cat("  No changes needed\n")
}

# Pivot for heatmap — use new treatment-based taxa order
heat_df <- corr_results %>%
  filter(Taxon %in% top_taxa, Gene %in% target_vars) %>%
  mutate(Taxon = factor(Taxon, levels = taxa_order),
         Gene  = factor(Gene, levels = target_vars),
         sig   = case_when(p < 0.001 ~ "***",
                           p < 0.01  ~ "**",
                           p < 0.05  ~ "*",
                           TRUE      ~ ""),
         label = sig)

# ============================================================================
# 6. LEfSe (KW + LDA score)
# ============================================================================
genus_meta <- genus_df %>%
  rownames_to_column("SampleID") %>%
  left_join(meta_raw %>% select(SampleID, Treatment1), by = "SampleID") %>%
  mutate(Treatment1 = gsub("^\\d+_", "", Treatment1))

TRT1_ORDER <- c("Control+Water","Control+SMT","Strep+Water","Strep+SMT")

BLUE <- "#1C66C0"
RED  <- "#C0392B"

trt_colors <- c(
  "Control+Water" = BLUE,
  "Control+SMT"   = BLUE,
  "Strep+Water"   = RED,
  "Strep+SMT"     = RED
)

# Ensure Treatment1 labels are clean before LEfSe
genus_meta <- genus_meta %>%
  mutate(Treatment1 = trimws(as.character(Treatment1)))

lefse_results <- lapply(taxa_order, function(taxon) {
  groups  <- split(genus_meta[[taxon]], genus_meta$Treatment1)
  groups  <- groups[intersect(TRT1_ORDER, names(groups))]
  kw_test <- kruskal.test(genus_meta[[taxon]] ~ factor(genus_meta$Treatment1))
  means    <- sapply(groups, function(g) mean(g, na.rm = TRUE))
  means    <- means[!is.na(means)]
  dominant <- trimws(as.character(names(which.max(means))))
  if (length(dominant) == 0 || !dominant %in% TRT1_ORDER) {
    # fallback: pick treatment with highest mean
    dominant <- TRT1_ORDER[which.max(sapply(TRT1_ORDER, function(t)
      mean(genus_meta[[taxon]][genus_meta$Treatment1 == t], na.rm = TRUE)))]
  }

  # LDA score: log10 of scaled between-group variance proxy
  X  <- log10(genus_meta[[taxon]] * 1e6 + 1)
  y  <- factor(genus_meta$Treatment1, levels = TRT1_ORDER)
  gm <- tapply(X, y, mean)
  om <- mean(X)
  lda_score <- log10(sum(sapply(TRT1_ORDER, function(t)
    sum(y == t) * (gm[t] - om)^2)) / length(X) + 1)

  data.frame(Taxon    = taxon,
             p_kw     = kw_test$p.value,
             dominant = dominant,
             lda_score = lda_score,
             stringsAsFactors = FALSE)
}) %>% bind_rows() %>%
  mutate(Taxon = factor(Taxon, levels = taxa_order),
         sig   = case_when(p_kw < 0.001 ~ "***",
                           p_kw < 0.01  ~ "**",
                           p_kw < 0.05  ~ "*",
                           TRUE         ~ ""))

cat("\nLEfSe results:\n")
print(lefse_results %>% arrange(desc(lda_score)) %>%
        select(Taxon, p_kw, dominant, lda_score, sig))

# ============================================================================
# 7. DC THEME
# ============================================================================
dc_theme <- theme_classic(base_size = 27) +
  theme(
    panel.border  = element_rect(colour = "black", fill = NA, linewidth = 1.0),
    axis.text     = element_text(size = 26, color = "black"),
    axis.title    = element_text(size = 29, color = "black", face = "bold"),
    legend.title  = element_text(size = 23, face = "bold", color = "black"),
    legend.text   = element_text(size = 22, color = "black"),
    plot.title    = element_text(size = 26, face = "bold", color = "black"),
    text          = element_text(color = "black")
  )

# ============================================================================
# 8. HEATMAP
# ============================================================================
fig_heat <- ggplot(heat_df, aes(x = Gene, y = Taxon, fill = r)) +
  geom_tile(colour = "white", linewidth = 0.4) +
  geom_text(aes(label = label), size = 7.8,
            colour = "black", fontface = "bold") +
  geom_vline(xintercept = 3.5, colour = "black", linewidth = 0.8,
             linetype = "dashed") +
  scale_fill_distiller(palette = "RdBu", limits = c(-0.55, 0.55),
                       name = "Spearman r\n(blue = +, red = −)") +
  scale_x_discrete(position = "top") +
  scale_y_discrete(limits = taxa_order, labels = taxa_labels) +
  labs(title = "Correlation with plant immunity\n& disease severity",
       x = NULL, y = NULL) +
  dc_theme +
  theme(axis.text.x     = element_text(size = 21, face = "bold",
                                              angle = 0,  color = "black"),
        axis.text.y     = element_text(size = 19, face = "italic",
                                              color = "black"),
        axis.ticks      = element_blank(),
        panel.border    = element_blank(),
        legend.position = "left") +
  # Divider lines between treatment groups
  geom_hline(
    yintercept = cumsum(table(ordering_df$dominant_trt)[TRT1_ORDER_TMP]) + 0.5,
    colour = "black", linewidth = 0.8, linetype = "dashed"
  )

# ============================================================================
# 9. LDA BAR — key: use same discrete y-axis as heatmap so bars align exactly
# ============================================================================
# Add pattern and stroke colour to lefse_results
lefse_results <- lefse_results %>%
  mutate(
    bar_pattern = case_when(
      dominant %in% c("Control+SMT", "Strep+SMT") ~ "circle",
      TRUE                                          ~ "none"
    ),
    bar_stroke = case_when(
      dominant %in% c("Control+SMT", "Strep+SMT") ~ "#AAAAAA",
      TRUE                                          ~ "black"
    )
  )

fig_lda <- ggplot(lefse_results,
                  aes(x = lda_score,
                      y = factor(Taxon, levels = taxa_order),
                      fill = dominant)) +
  ggpattern::geom_col_pattern(
    aes(pattern      = bar_pattern,
        pattern_fill = dominant),
    colour          = "black",
    linewidth       = 0.5,
    alpha           = 0.85,
    width           = 1.0,
    pattern_colour  = "white",
    pattern_fill    = "white",
    pattern_spacing = 0.055,
    pattern_density = 0.4,
    pattern_size    = 0.5
  ) +
  scale_pattern_identity() +
  scale_pattern_fill_manual(values = trt_colors, guide = "none") +
  geom_text(aes(x = lda_score + max(lefse_results$lda_score) * 0.05,
                label = sig),
            hjust = 0, size = 9.1, fontface = "bold", colour = "black") +
  scale_fill_manual(
    values   = trt_colors,
    na.value = RED,
    name     = "Treatment\nassociation",
    labels   = c("Control+Water", "Control+SMT (SMT)",
                 "Strep+Water",   "Strep+SMT (SMT)"),
    drop     = FALSE
  ) +
  scale_y_discrete(limits = taxa_order, labels = taxa_labels) +
  scale_x_continuous(expand = expansion(mult = c(0, 0.25)),
                     breaks = c(0, 0.04, 0.08),
                     labels = c("0", "0.04", "0.08"),
                     limits = c(0, NA)) +
  labs(title = "LEfSe\ntreatment association",
       x = "LDA score (log\u2081\u2080)", y = NULL) +
  dc_theme +
  theme(axis.text.y     = element_blank(),
        axis.ticks.y    = element_blank(),
        axis.line.y     = element_blank(),
        legend.position = "right") +
  geom_hline(
    yintercept = cumsum(table(ordering_df$dominant_trt)[TRT1_ORDER_TMP]) + 0.5,
    colour = "black", linewidth = 0.8, linetype = "dashed"
  ) +
  guides(fill = guide_legend(
    override.aes = list(
      pattern       = c("none","circle","none","circle"),
      pattern_fill  = c(BLUE, BLUE, RED, RED),
      pattern_colour = "white",
      colour        = "black"
    )
  ))

# ============================================================================
# 10. COMBINE & SAVE
# ============================================================================
combined <- fig_heat + fig_lda +
  plot_layout(widths = c(1, 0.6)) +
  plot_annotation(
    theme = theme(
      plot.title    = element_blank(),
      plot.subtitle = element_blank()
    )
  )

ggsave("figure_heatmap_lefse_text_test.pdf", combined, width = 13, height = 15, dpi = 1200)
ggsave("figure_heatmap_lefse_text.png", combined, width = 13, height = 15, dpi = 1200)
cat("\nSaved: figure_heatmap_lefse.pdf  and  figure_heatmap_lefse.png\n")

